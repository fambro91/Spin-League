{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spin-league",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Un solo cron orario: il codice controlla l'ora di Roma (18:00 promemoria, 21:00 giornata).
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spin-league",
      // SOSTITUIRE con l'ID del database D1 creato nella dashboard Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
